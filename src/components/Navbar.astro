---
import { Menu, X, ArrowUpRight } from 'lucide-react';
import LogoPicture from './LogoPicture.astro';
const NAV_ITEMS = [
  { name: 'Servicios', href: '#servicios' },
  { name: 'Cómo trabajamos', href: '#elegirnos' },
  { name: 'Equipo', href: '#equipo' },
  { name: 'Contacto', href: '#contacto' },
];
---
<header id="site-header" class="site-header fixed top-0 left-0 right-0 z-50">
  <nav aria-label="Navegación principal" class="site-navigation">
    <a href="#hero" aria-label="LEGORO, inicio" class="brand-link"><LogoPicture priority imgClassName="nav-logo" /></a>
    <div class="desktop-links">{NAV_ITEMS.map(({ name, href }) => <a href={href}>{name}</a>)}</div>
    <a href="#contacto" class="nav-quote">Presupuestá <ArrowUpRight size={17} aria-hidden="true" /></a>
    <button id="menu-open" type="button" aria-label="Abrir menú" aria-controls="mobile-menu" aria-expanded="false" data-menu-open><Menu size={24} aria-hidden="true" /></button>
  </nav>
  <div id="mobile-menu" role="dialog" aria-modal="true" aria-label="Navegación" hidden>
    <div class="mobile-menu-top"><LogoPicture imgClassName="menu-logo" /><button data-menu-close type="button" aria-label="Cerrar menú"><X size={24} aria-hidden="true" /></button></div>
    <div class="mobile-links">{NAV_ITEMS.map(({ name, href }) => <a href={href} data-menu-close>{name}<ArrowUpRight size={22} aria-hidden="true" /></a>)}</div>
    <a href="#contacto" data-menu-close class="mobile-quote">Consultá por tu proyecto <ArrowUpRight size={20} aria-hidden="true" /></a>
  </div>
</header>
<script>import '../scripts/navigation';</script>
<style>
  .site-header { height: 6rem; background: var(--color-industrial-navy); color: oklch(96% .008 245); border-bottom: 1px solid oklch(35% .035 255); }
  .site-navigation { max-width: 84rem; height: 100%; margin-inline: auto; padding-inline: 1.5rem; display: flex; align-items: center; gap: 1.5rem; }
  .brand-link { margin-right: auto; display: flex; align-items: center; min-height: 44px; }
  .brand-link :global(.nav-logo) { height: 4rem; width: auto; object-fit: contain; }
  .desktop-links { display: none; align-items: center; gap: 1.5rem; font-size: .95rem; }
  a { min-height: 44px; display: inline-flex; align-items: center; }
  a:hover { text-decoration: underline; text-underline-offset: .35em; }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--color-industrial-accent); outline-offset: 5px; }
  .nav-quote { display: none; gap: .75rem; border: 1px solid var(--color-industrial-accent); padding: .65rem 1rem; border-radius: .25rem; font-size: .95rem; font-weight: 600; }
  button { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; cursor: pointer; }
  #mobile-menu { position: fixed; inset: 0; height: 100dvh; overflow-y: auto; background: var(--color-industrial-navy); padding: 1.5rem; display: flex; flex-direction: column; }
  .mobile-menu-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; }
  .mobile-menu-top :global(.menu-logo) { height: 3.5rem; width: auto; }
  .mobile-links { display: flex; flex-direction: column; }
  .mobile-links a { justify-content: space-between; padding-block: 1rem; border-bottom: 1px solid oklch(35% .035 255); font-size: clamp(1.25rem, 6vw, 1.75rem); }
  .mobile-quote { gap: 1rem; width: fit-content; margin-top: 2rem; background: var(--color-industrial-accent); color: var(--color-industrial-base); padding: 1rem; border-radius: .25rem; font-weight: 600; }
  @media (min-width: 768px) { .desktop-links, .nav-quote { display: flex; } #menu-open { display: none; } .site-navigation { gap: 1.25rem; } }
  @media (min-width: 1024px) { .site-navigation { padding-inline: 2rem; } .desktop-links { gap: 2rem; } .nav-quote { margin-left: 1rem; } }
</style>
