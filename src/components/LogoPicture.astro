---
interface Props { className?: string; imgClassName?: string; priority?: boolean; }
const { className, imgClassName, priority } = Astro.props;
---
<picture class={className}>
      <source srcset="/legoro-logo-400.avif" type="image/avif" />
      <source srcset="/legoro-logo-400.webp" type="image/webp" />
      
      <img
        src="/LEGORO LOGO NO Background .png"
        alt="LEGORO Logo"
        class={imgClassName}
        width="400"
        height="289"
        fetchpriority={priority ? 'high' : 'auto'}
        decoding={priority ? 'sync' : 'async'}
      />
    </picture>
