---
import ContactForm from "./ContactForm";
import { Phone, Mail, MapPin } from "lucide-react";
---
<section id="contacto" aria-labelledby="contacto-heading" class="py-24 md:py-32 bg-[#EEF1F3]">
<div class="container mx-auto px-2 sm:px-6 md:px-8"><div class="max-w-6xl mx-auto flex flex-col lg:flex-row rounded-3xl overflow-hidden shadow-[0_25px_60px_rgba(0,0,0,0.25)] border border-[#B0BEC5]/30">
            {/* Left panel */}
            <div class="contact-intro min-w-0 lg:w-1/2 bg-[#0A1628] p-6 md:p-12 flex flex-col justify-between text-center lg:text-left relative">
              <div class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.04)_1px,transparent_1px)] bg-size-[24px_24px] pointer-events-none" aria-hidden="true" />

              <div class="relative z-10 w-full flex flex-col items-center lg:items-start">
                <h2 id="contacto-heading" class="font-jakarta font-semibold text-[#EEF1F3] contact-heading leading-tight mb-6 text-center lg:text-left w-full">
                  Consultanos
                </h2>
                <p class="font-jakarta font-normal text-[#EEF1F3]/60 text-base max-w-md text-center lg:text-left w-full">
                  Dejanos tu consulta en el formulario o escribinos por WhatsApp. También podés llamarnos o enviarnos un correo.
                </p>
              </div>

              <div class="space-y-4 mt-12 md:mt-20 flex flex-col items-center lg:items-start relative z-10 w-full">
                <a href="tel:+5492235768622" class="flex max-w-full items-center gap-4 bg-[#EEF1F3]/6 border border-[#EEF1F3]/15 rounded-full px-5 py-3 text-[#EEF1F3] text-sm font-bold tracking-wider focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#EEF1F3]">
                  <Phone className="w-5 h-5 shrink-0 text-[#B0BEC5]" aria-hidden="true" />
                  <span>+54 9 2235 76-8622</span>
                </a>
                <a href="mailto:ezequielleonardiing@gmail.com" class="flex max-w-full items-center gap-4 bg-[#EEF1F3]/6 border border-[#EEF1F3]/15 rounded-full px-5 py-3 text-[#EEF1F3] text-sm font-bold focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#EEF1F3]">
                  <Mail className="w-5 h-5 shrink-0 text-[#B0BEC5]" aria-hidden="true" />
                  <span class="min-w-0 wrap-anywhere">ezequielleonardiing@gmail.com</span>
                </a>
                <div class="flex items-center gap-4 bg-[#EEF1F3]/6 border border-[#EEF1F3]/15 rounded-full px-5 py-3 text-[#EEF1F3] text-sm font-bold tracking-wider">
                  <MapPin className="w-5 h-5 text-[#B0BEC5]" aria-hidden="true" />
                  <span>Mar del Plata, Argentina</span>
                </div>
              </div>
            </div>

<div class="min-w-0 lg:w-1/2 px-2 py-8 sm:px-8 md:p-12 bg-[#EEF1F3] flex flex-col gap-6"><ContactForm client:load /></div></div></div></section>

<style>
  .contact-intro { container-type: inline-size; }
  .contact-heading {
    /* Size against this panel, not the viewport when the layout splits in two. */
    font-size: clamp(1.75rem, 12cqi, 3.5rem);
    max-inline-size: 100%;
    white-space: nowrap;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
    letter-spacing: -.025em;
  }
</style>
