---
import { SERVICES } from '@/lib/data';
---
<section id="servicios" aria-labelledby="services-heading" class="services-section">
  <div class="services-inner">
    <div class="services-intro">
      <h2 id="services-heading">Qué necesitás resolver</h2>
    </div>
    <ul class="service-list">
      {SERVICES.map((service) => (
        <li data-service-id={service.id}>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </li>
      ))}
    </ul>
    <a class="services-contact" href="#contacto">¿No sabés qué servicio necesitás? Contanos tu consulta.</a>
  </div>
</section>
<style>
  .services-section { background: oklch(97% .009 245); color: var(--color-industrial-base); padding: 5rem 1.5rem; }
  .services-inner { max-width: 80rem; margin-inline: auto; }
  .services-intro { max-width: 45rem; margin-bottom: 3rem; }
  h2 { font-family: var(--font-space-grotesk); font-size: clamp(2rem, 3.5vw, 3.1rem); font-weight: 550; line-height: 1.2; letter-spacing: -.025em; text-wrap: balance; }
  .services-intro p { margin-top: 1.2rem; max-width: 57ch; color: oklch(39% .025 255); font-size: 1.05rem; line-height: 1.75; }
  .service-list { border-top: 1px solid oklch(77% .02 245); }
  .service-list li { display: grid; gap: .8rem; padding-block: 1.75rem; border-bottom: 1px solid oklch(82% .018 245); }
  h3 { font-family: var(--font-space-grotesk); font-size: clamp(1.3rem, 2.1vw, 1.8rem); font-weight: 500; line-height: 1.35; }
  .service-list p { font-size: 1rem; line-height: 1.75; color: oklch(39% .025 255); max-width: 59ch; }
  .services-contact { display: inline-flex; align-items: center; min-height: 44px; margin-top: 1rem; text-decoration: underline; text-underline-offset: .3em; line-height: 1.65; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  @media (min-width: 640px) { .service-list li { grid-template-columns: 1fr 1.5fr; gap: 3rem; } }
  @media (min-width: 1024px) {
    .services-section { padding: 6rem 2rem; }
    .services-intro { margin-bottom: 4rem; }
    .service-list li { padding-block: 2rem; }
  }
</style>
