---
import { ArrowUpRight } from 'lucide-react';
---
<section id="hero" aria-labelledby="hero-heading" class="photographic-hero">
  <picture class="hero-background">
    <source media="(max-width: 768px)" srcset="/City_Background-sm.avif" type="image/avif" />
    <source media="(max-width: 768px)" srcset="/City_Background-sm.webp" type="image/webp" />
    <source srcset="/City_Background.avif" type="image/avif" />
    <source srcset="/City_Background.webp" type="image/webp" />
    <img src="/City_Background.png" alt="" width="2752" height="1536" fetchpriority="high" decoding="sync" />
  </picture>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="hero-copy">
    <h1 id="hero-heading">Eficiencia energética y seguridad eléctrica para tu proyecto.</h1>
    <p>Diseñamos, dirigimos y ejecutamos instalaciones eléctricas, sistemas de energía y automatización. Trabajamos desde Mar del Plata en proyectos de la ciudad y otras localidades.</p>
    <div class="hero-actions">
      <a class="hero-quote" href="#contacto">Presupuestá tu proyecto <ArrowUpRight aria-hidden="true" size={21} /></a>
      <a class="hero-services-link" href="#servicios">Conocé los servicios</a>
    </div>
    </div>
  </div>
</section>
<style>
  .photographic-hero { position: relative; isolation: isolate; overflow: hidden; background: var(--color-industrial-base); color: oklch(98% .005 245); min-height: 42rem; display: flex; align-items: center; padding: 11rem 1.5rem 6rem; }
  .hero-background, .hero-background img, .hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-background { z-index: -2; }
  .hero-background img { object-fit: cover; object-position: center; }
  .hero-shade { z-index: -1; background: oklch(19% .055 255 / .66); }
  .hero-inner { width: 100%; max-width: 80rem; margin-inline: auto; text-align: center; }
  .hero-copy { max-width: 52rem; margin-inline: auto; }
  h1 { max-width: 18ch; margin-inline: auto; font-family: var(--font-plus-jakarta-sans); font-size: clamp(2.25rem, 4.5vw, 4.5rem); font-weight: 650; line-height: 1.12; letter-spacing: -.025em; text-wrap: balance; }
  p { max-width: 55ch; margin: 1.75rem auto 0; font-size: clamp(1rem, 1.5vw, 1.2rem); line-height: 1.75; color: oklch(95% .008 245); }
  .hero-actions { width: fit-content; max-width: 100%; margin-inline: auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 1rem 2rem; margin-top: 2.25rem; }
  .hero-quote { display: inline-flex; align-items: center; justify-content: center; gap: 1.25rem; min-height: 3.5rem; padding: 1rem 1.4rem; background: var(--color-industrial-accent); color: var(--color-industrial-base); border-radius: .3rem; font-weight: 650; }
  .hero-quote:hover { background: oklch(96% .008 245); }
  .hero-services-link { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; text-underline-offset: .35em; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  @media (min-width: 1024px) {
    .photographic-hero { min-height: 46rem; padding: 11rem 2rem 6rem; }
    .hero-inner { text-align: left; }
    .hero-copy { margin-inline: 0; }
    h1, p { margin-left: 0; }
    .hero-actions { margin-left: 0; justify-content: flex-start; }
    .hero-shade { background: linear-gradient(90deg, oklch(18% .055 255 / .9), oklch(18% .055 255 / .62) 58%, oklch(18% .055 255 / .25)); }
  }
</style>
