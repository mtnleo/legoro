---
import { ExternalLink } from 'lucide-react';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ezequielPortrait from '../assets/team/ezequiel-leonardi.jpeg';
import matiasPortrait from '../assets/team/matias-rocca.jpeg';
import leandroPortrait from '../assets/team/leandro-gonzalez.jpeg';
import { TEAM } from '@/lib/data';

const portraits: Record<string, ImageMetadata> = {
  'Ezequiel Leonardi': ezequielPortrait,
  'Matías Rocca': matiasPortrait,
  'Leandro González': leandroPortrait,
};
---
<section id="equipo" class="py-24 md:py-32 bg-white/2 border-y border-white/5">
      <div class="container mx-auto px-6 md:px-8">
        <div class="text-center mb-20">
          <h4 class="text-xs uppercase font-black tracking-[0.5em] text-industrial-accent mb-4 font-title">
            Capital Intelectual
          </h4>
          <h2 class="text-4xl md:text-6xl font-black tracking-tighter font-display uppercase italic">
            Nuestro Equipo de Expertos
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {TEAM.map((member) => (
            <div
              class="bg-industrial-surface rounded-4xl overflow-hidden border border-white/5 hover:border-industrial-accent hover:-translate-y-2.5 transition-all duration-300 group flex flex-col items-center"
            >
              <div class="w-full aspect-4/3 bg-industrial-navy/50 relative overflow-hidden">
                <Image
                  src={portraits[member.name]}
                  alt={`Retrato de ${member.name}`}
                  width={800}
                  widths={[320, 480, 640, 800, 1200]}
                  sizes="(min-width: 1536px) 469px, (min-width: 1280px) 384px, (min-width: 1024px) 299px, (min-width: 768px) 213px, calc(100vw - 48px)"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover object-top"
                />
              </div>

              <div class="p-8 text-center w-full">
                <h4 class="text-xl font-black tracking-tight mb-1">
                  {member.name.split(' ')[0]}
                  <br />
                  {member.name.split(' ').slice(1).join(' ')}
                </h4>
                <p class="text-xs font-bold uppercase tracking-widest text-industrial-accent opacity-70">
                  {member.role}
                </p>
                <div class="mt-6 flex justify-center gap-4">
                  <a
                    aria-label={`LinkedIn de ${member.name}`}
                    href={member.linkedin}
                    class="p-2 bg-white/5 rounded-full hover:bg-industrial-accent hover:text-industrial-base transition-all"
                  >
                    <ExternalLink className="w-4 h-4" />
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
