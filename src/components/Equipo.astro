---
import { ExternalLink } from 'lucide-react';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ezequielPortrait from '../assets/team/ezequiel-leonardi.jpeg';
import matiasPortrait from '../assets/team/matias-rocca.jpeg';
import leandroPortrait from '../assets/team/leandro-gonzalez.jpeg';
import { TEAM } from '@/lib/data';

const portraits: Record<string, ImageMetadata> = {
  'Ezequiel Leonardi': ezequielPortrait,
  'Matías Rocca': matiasPortrait,
  'Leandro González': leandroPortrait,
};
---
<section id="equipo" aria-labelledby="team-heading" class="team-section">
  <div class="team-inner">
    <div class="team-intro">
      <h2 id="team-heading">El equipo de LEGORO</h2>
      <p>Somos ingenieros electromecánicos de la Universidad Nacional de Mar del Plata (UNMdP).</p>
    </div>
    <div class="team-members">
      {TEAM.map((member, index) => (
        <article class="team-member" data-team-member={member.name} aria-labelledby={`member-${index}`}>
          <div class="portrait-frame">
            <Image
              src={portraits[member.name]}
              alt={`Retrato de ${member.name}`}
              width={800}
              widths={[320, 480, 640, 800, 1200]}
              sizes="(min-width: 1152px) 345px, (min-width: 1024px) calc((100vw - 116px) / 3), (min-width: 768px) calc((100vw - 100px) / 3), calc(100vw - 50px)"
              format="webp"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover object-top"
            />
          </div>
          <div class="member-details">
            <h3 id={`member-${index}`}>{member.name}</h3>
            <p>{member.role}</p>
            <a href={member.linkedin} aria-label={`LinkedIn de ${member.name}`}><span>LinkedIn</span><ExternalLink size={17} aria-hidden="true" /></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .team-section { padding: 4rem 1.5rem; background: var(--color-industrial-base); color: oklch(96% .008 245); }
  .team-inner { max-width: 68rem; margin-inline: auto; }
  .team-intro { max-width: 48rem; margin-bottom: 2rem; }
  h2 { font-family: var(--font-space-grotesk); font-size: clamp(2rem, 3.4vw, 3rem); font-weight: 500; line-height: 1.2; letter-spacing: -.025em; }
  .team-intro p { margin-top: 1.2rem; font-size: 1.05rem; line-height: 1.75; color: oklch(85% .015 245); }
  .team-members { display: grid; gap: 1.5rem; align-items: stretch; }
  .team-member { min-width: 0; display: flex; flex-direction: column; overflow: hidden; border: 1px solid oklch(44% .025 255); border-radius: 1.5rem; background: var(--color-industrial-navy); }
  .portrait-frame { position: relative; aspect-ratio: 4/3; overflow: hidden; background: var(--color-industrial-accent); }
  .member-details { padding: 1.25rem; text-align: center; }
  h3 { font-family: var(--font-plus-jakarta-sans); font-weight: 650; font-size: 1.15rem; line-height: 1.4; }
  .team-member p { margin-top: .4rem; color: oklch(83% .015 245); line-height: 1.65; font-size: .9rem; }
  a { display: inline-flex; align-items: center; justify-content: center; gap: .6rem; min-height: 44px; margin-top: .5rem; padding-inline: .75rem; color: var(--color-industrial-accent); font-size: .9rem; text-decoration: underline; text-underline-offset: .3em; }
  a :global(svg) { flex-shrink: 0; }
  a:focus-visible { outline: 2px solid var(--color-industrial-accent); outline-offset: 2px; }
  @media (min-width: 768px) { .team-members { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .team-section { padding: 5rem 2rem; } }
</style>
